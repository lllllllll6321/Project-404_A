# /.gitignore — Unreal Engine 5 project

# Ignore user-specific files
Saved/
Intermediate/
DerivedDataCache/
Debug/
.vscode/
.vs/
*.VC.db
*.VC.VC.opendb
*.suo
*.user
*.userosscache
*.sln.docstates

# Ignore build artifacts
Binaries/
Build/
BuildDerivedDataCache/

# Ignore cooked builds
# Only if you’re NOT committing packaged builds
WindowsNoEditor/
Windows/
Linux/
Mac/
Android/
HTML5/
IOS/

# Logs
*.log
*.dmp

# Crash reports and local backups
*.tmp
*.bak
*.old
*.orig
*.cache
*.mdb

# Compiled assets
*.pyc
*.pyo
*.pyd

# Ignore IDE configs
.idea/
*.sln
*.opensdf
*.sdf

# Ignore Git merge conflicts
*.orig

# Ignore generated by Epic Launcher
EpicGamesLauncher/
EpicGamesLauncher.log

# Ignore packaged project
Saved/StagedBuilds/
Releases/

# Optional: Ignore local config override (keep defaults only)
Config/DefaultEditorPerProjectUserSettings.ini
Config/DefaultEditor.ini

# Optional: Ignore plugin intermediates
Plugins/*/Intermediate/
Plugins/*/Binaries/
